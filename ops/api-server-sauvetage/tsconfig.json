{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@workspace/lead-core": ["./reconciled/lead-core/src/index.ts"]
    }
  },
  "include": ["characterization/**/*.ts", "reconciled/**/*.ts", "from-hosts/**/*.ts"]
}
